# Keep ASCII art, tests, and scripts line-ending-stable across Windows checkouts.
* text=auto eol=lf

# Review-grid fixtures preserve explicit canvas width with trailing spaces.
style_samples/review/*.txt whitespace=-blank-at-eol,-blank-at-eof
style_samples/corrections/*.txt whitespace=-blank-at-eol,-blank-at-eof

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
